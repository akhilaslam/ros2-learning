{
  "name": "ROS 2 Humble Workspace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "redhat.vscode-yaml"
      ]
    }
  },
  "forwardPorts": [6080],
  "postCreateCommand": "echo 'source /opt/ros/humble/setup.bash' >> ~/.bashrc"
}
